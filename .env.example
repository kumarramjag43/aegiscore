# ============================================================================
# AegisCore — environment configuration
# Copy to `.env` at the repository root:  cp .env.example .env
#
# Every key is OPTIONAL. With no keys present, AegisCore runs in
# "Interactive Demo Sandbox Mode": the exact same 4-agent pipeline executes,
# driven by deterministic domain analyzers instead of a remote LLM.
# ============================================================================

# Force a specific provider: openai | groq | gemini | anthropic | demo
# When unset, AegisCore auto-selects the first configured provider.
# AEGIS_PROVIDER=demo

# --- OpenAI ---------------------------------------------------------------
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- Groq (OpenAI-compatible) --------------------------------------------
# GROQ_API_KEY=gsk_...
# GROQ_MODEL=llama-3.3-70b-versatile
# GROQ_BASE_URL=https://api.groq.com/openai/v1

# --- Google Gemini --------------------------------------------------------
# GEMINI_API_KEY=...
# GEMINI_MODEL=gemini-2.0-flash

# --- Anthropic ------------------------------------------------------------
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-4-20250514

# --- Runtime tuning (optional) -------------------------------------------
# Per-agent-call timeout in milliseconds (default 45000)
# AEGIS_LLM_TIMEOUT_MS=45000
# Maximum characters accepted per audit request (default 200000)
# AEGIS_MAX_INPUT_CHARS=200000

# --- Deployment / demo mode ----------------------------------------------
# DEMO_MODE=true pins every run to the deterministic sandbox engine, even if a
# provider key is present. Leave it unset to auto-detect keys.
# DEMO_MODE=true

# Public URLs used by the launch portal (apps/portal) for its buttons and
# status pills. These are links only — never put a secret behind NEXT_PUBLIC_.
# NEXT_PUBLIC_CODEMEDIC_URL=https://codemedic.example.com
# NEXT_PUBLIC_LEXGUARD_URL=https://lexguard.example.com
